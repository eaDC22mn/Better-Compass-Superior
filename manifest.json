{
  "manifest_version": 3,
  "name": "Better Compass Superior",
  "version": "1.9.4",
  "icons": {
    "128": "icon-128.png"
  },
  "description": "Compass QOL overhaul. Compass like never seen before.",
  "permissions": [
    "storage",
	"tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.compass.education/*"
      ],
      "all_frames": true,
      "js": [
        "content.js",
        "altmenu.js"
      ],
      "css": [
        "styles.css",
        "altmenu.css"
      ]
    },
    {
      "matches": [
        "https://*.compass.education/*"
      ],
      "js": [
        "saml-autoclick.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "game/index.html",
        "options.html",
        "altmenu.html",
        "altmenu.css",
        "altmenu.js",
        "altmenu-icon.png",
        "icon-128.png",
        "info.png",
        "bcslogo.png",
        "backgrounds/*"
      ],
      "matches": [
        "https://*.compass.education/*"
      ]
    }
  ],

 "action": {
    "default_popup": "menu.html",
    "default_title": "Better Compass Superior"
 }


}

